# =============================================================================
# Amar Residence — environment variables
# Copy to .env and fill in values:  copy .env.example .env
# =============================================================================

# --- Database (PostgreSQL required for local + production) -------------------
#
# Local dev with Docker:
#   docker compose up -d
#   DATABASE_URL="postgresql://amar:amar@localhost:5432/amar_residence?schema=public"
#
# Production (Railway / Neon / Supabase):
#   Paste the connection string from your host dashboard.
#
DATABASE_URL="postgresql://amar:amar@localhost:5432/amar_residence?schema=public"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="RealtyBytes PMS"

# --- Auth (REQUIRED — use a long random string in production!) ---------------
# Generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#
AUTH_SECRET="change-me-to-a-random-string-at-least-32-characters-long"

# --- First-time database bootstrap (required for db:seed / db:reset) ---------
# Creates one admin account and loads all rooms as vacant. Wipes existing data.
SEED_ADMIN_EMAIL="admin@amarresidence.com"
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_PASSWORD="choose-a-strong-password-at-least-6-chars"

# --- Optional: only set on Railway if you need a public URL for redirects ----
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

# --- Optional: lobby room-status display (32" monitor / front desk TV) -------
# If set, open /lobby?key=YOUR_KEY on the lobby browser. Read-only, no login.
# LOBBY_DISPLAY_KEY="choose-a-long-random-lobby-key"
#
# Full screen:  /lobby?key=YOUR_KEY
# Split + ads:  /lobby?key=YOUR_KEY&split=1&ads=https://your-ad-slideshow-url
# Rooms on right instead of left: add &side=right
# LOBBY_ADS_URL="https://your-ad-slideshow-url"

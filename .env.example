# =============================================================================
# Amar Residence — environment variables
# Copy to .env and fill in values:  copy .env.example .env
# =============================================================================

# --- Database (PostgreSQL required for local + production) -------------------
#
# Local dev with Docker:
#   docker compose up -d
#   DATABASE_URL="postgresql://amar:amar@localhost:5432/amar_residence?schema=public"
#
# Production (Railway / Neon / Supabase):
#   Paste the connection string from your host dashboard.
#
DATABASE_URL="postgresql://amar:amar@localhost:5432/amar_residence?schema=public"

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Amar Residence"

# --- Auth (REQUIRED — use a long random string in production!) ---------------
# Generate (PowerShell):
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
#
AUTH_SECRET="change-me-to-a-random-string-at-least-32-characters-long"

# --- Optional: only set on Railway if you need a public URL for redirects ----
# NEXT_PUBLIC_APP_URL="https://your-app.up.railway.app"

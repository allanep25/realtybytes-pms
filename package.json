{
  "name": "amar-residence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --schema=./prisma/schema.prisma && next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "tsx prisma/seed.ts",
    "db:demo-seed": "tsx prisma/demo-seed.ts",
    "db:deploy": "prisma migrate deploy && tsx prisma/deploy-seed-if-empty.ts && tsx prisma/backfill-folio-payments.ts",
    "db:update-rates": "tsx prisma/update-rates.ts",
    "db:backdate-arrivals": "tsx prisma/backdate-today-arrivals.ts",
    "db:shift-checkin-date": "tsx prisma/shift-checkin-date.ts",
    "db:purge-date-range": "tsx prisma/purge-date-range.ts",
    "db:relocate-guest": "tsx prisma/relocate-guest.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "prisma": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tsx": "^4.19.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.3",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  }
}
